<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>custom_controller</name>

  <version>0.0.0</version>

  <description>
    Custom ROS 2 controller for an omnidirectional robot
  </description>

  <maintainer email="thusithamadushanakade@gmail.com">
    thusitha_madushanaka
  </maintainer>

  <license>Apache-2.0</license>


  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>


  <!-- ROS 2 Control -->
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- ROS 2 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>


  <!-- Our kinematics library -->
  <depend>custom_controller_kinematics</depend>


  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>controller_manager</test_depend>
  <test_depend>ros2_control_test_assets</test_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>